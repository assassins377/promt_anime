#!/bin/sh
# No credentials in this file or the release's public COOKIE placeholder.
if [ "${#RELEASE_COOKIE}" -lt 32 ]; then
  echo 'RELEASE_COOKIE must be supplied externally (at least 32 characters).' >&2
  exit 2
fi

if [ -z "${RELEASE_TMP:-}" ] || [ ! -d "$RELEASE_TMP" ] || [ ! -w "$RELEASE_TMP" ]; then
  echo 'RELEASE_TMP must name an existing writable external directory.' >&2
  exit 2
fi
RELEASE_TMP="$(CDPATH= cd -- "$RELEASE_TMP" && pwd -P)"
case "$RELEASE_TMP" in
  "$RELEASE_ROOT"|"$RELEASE_ROOT"/*)
    echo 'RELEASE_TMP must be outside the release package.' >&2
    exit 2
    ;;
esac
export RELEASE_TMP

# Only local release preflight is accepted in the current implementation slice.
# Do not accidentally open Erlang distribution while checking a package.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ "$RELEASE_DISTRIBUTION" != none ]; then
  echo 'Distributed release startup remains disabled in this slice.' >&2
  exit 2
fi
