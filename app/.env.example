# Только локальная разработка. Скопируйте в .env и заполните секреты сами.
# Это параметры реализованного web/dev-среза, не полного production-релиза.
# Обязательные: APP_ENV, NODE_ROLE, PHX_HOST, оба секрета, DATABASE_URL,
# MINIO_ENDPOINT, MINIO_PUBLIC_URL и оба ключа MinIO. Пустое значение не считается отсутствующим.
APP_ENV=dev
NODE_ROLE=web
# Необязательна на dev: пусто — никаким прокси не доверяем, включая loopback.
# Только реальные CIDR вашего прокси через запятую; не используйте сети всего интернета.
TRUSTED_PROXIES=
# Только DNS-имя (IDN в punycode) или IPv4, без схемы, порта и пути.
PHX_HOST=localhost
# Необязательные: PORT 1–65535 (4000), PHX_SERVER true/false (false).
PORT=4000
PHX_SERVER=true
# Отдельный порт метрик, только 127.0.0.1; включается вместе с PHX_SERVER.
# Не проксировать в публичный сайт. Должен отличаться от PORT.
METRICS_PORT=9568
# Только ecto/postgres/postgresql; URL-опции ssl, timeout, idle_interval.
# Для SSL используйте один согласованный выбор: DATABASE_SSL или ssl в URL.
DATABASE_URL=ecto://postgres@127.0.0.1:59432/anime_dev
TEST_DATABASE_URL=ecto://postgres@127.0.0.1:59432/anime_test
# Необязательные: DATABASE_SSL true/false (локально false), POOL_SIZE > 0 (10).
DATABASE_SSL=false
POOL_SIZE=10
# Необязательные: debug/info/warning/error; UTC; local. SMTP пока не реализован.
# Dev/test use debug per specification; LOG_LEVEL is validated, not used to lower it.
LOG_LEVEL=debug
TZ=UTC
MAIL_ADAPTER=local
# Два независимых значения (минимум 64 / 32 символа): openssl rand -hex 64 / openssl rand -hex 32
SECRET_KEY_BASE=
LIVE_VIEW_SIGNING_SALT=
# Если MinIO ещё не поднят, /readyz будет 503; формы аккаунта работают без него.
# Оба адреса: HTTP(S) origin, без логина, бакета/пути, query и fragment.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_URL=http://localhost:9000
# Необязательная, по умолчанию us-east-1.
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET_ORIGINALS=anime-originals
MINIO_BUCKET_VIDEO=anime-video
MINIO_BUCKET_PREVIEWS=anime-previews
MINIO_BUCKET_POSTERS=anime-posters
MINIO_BUCKET_AVATARS=anime-avatars
# Только для необязательного seed владельца. Не используйте настоящий пароль.
ADMIN_EMAIL=
ADMIN_NICK=
ADMIN_PASSWORD=
